# App
APP_NAME="SC Trade Optimization Platform"
ENV=development
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Database
DATABASE_URL=sqlite+aiosqlite:///./data/trading_platform.db

# Security
SECRET_KEY=change-me-in-production-use-32-random-bytes-min
API_KEY=

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=text

# Statistical Analysis Gate
BH_FDR_ALPHA=0.05
MIN_TRADES_FOR_PROMOTION=30

# Walk-Forward Defaults
WF_IN_SAMPLE_DAYS=252
WF_OUT_OF_SAMPLE_DAYS=63

# Monte Carlo Defaults
MC_SIMULATIONS=10000
MC_RUIN_THRESHOLD=0.50
