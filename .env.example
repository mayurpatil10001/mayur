# ==============================================================================
# Sierra Chart Trade Optimization Platform — Public Environment Template
# Rename this file to .env before running the application.
# ==============================================================================

# Security & Secret Keys (Generate secure random 32+ char strings for production)
SECRET_KEY=your-random-secret-key-min-32-chars-long
JWT_SECRET_KEY=your-random-jwt-secret-key-min-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=30
DEVELOPMENT_MODE=true

# Database Configuration
DATABASE_URL=sqlite:///trading_platform.db
DB_PATH=trading_platform.db

# API & Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=false
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# MCP & External Service Keys
MCP_SERVER_URL=http://localhost:8080
MCP_API_KEY=your-mcp-api-key-here

# Sierra Chart Data Source Feeds
SIERRA_CHART_SIMULATED_PATH=/path/to/SierraChart_Simulated_Feed/SavedTradeActivity
SIERRA_CHART_DELAYED_PATH=/path/to/SierraChart_Delayed_Simulated/SavedTradeActivity

# Analysis & Logging Parameters
RISK_FREE_RATE=0.02
CONFIDENCE_LEVEL=0.95
LOG_LEVEL=INFO
LOG_FILE=trading_platform.log
MAX_FILE_SIZE_MB=100
BATCH_SIZE=1000
RATE_LIMIT_PER_MINUTE=500
